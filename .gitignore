# --- Python / backend ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.log

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Node / frontend ---
node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
