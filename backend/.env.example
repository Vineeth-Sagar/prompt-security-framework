# Copy to backend/.env for local (non-Docker) development, or set these as
# the `backend.env_file`/env values in docker-compose.yml for containerized
# runs. Fields marked (used later) are read by config.py today but not yet
# consumed by application code — that lands with the corresponding phase.

APP_NAME=prompt-security-framework
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS — the dashboard origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:3000

# (used later — Phase 3 context buffer) Redis connection
REDIS_URL=redis://localhost:6379/0

# (used later — Phase 10 explainable logging) Postgres connection
DATABASE_URL=postgresql+asyncpg://psf:psf@localhost:5432/psf

# (used later — Phase 9 auth/RBAC) JWT signing secret — MUST be overridden
# with a strong random value outside development.
JWT_SECRET=dev-secret-change-me

# (used later — Phase 7 LLM gateway) Anthropic API key for the target LLM
ANTHROPIC_API_KEY=

# (used later — Phase 4 SWCSA) drift-score threshold and sliding-window size
DRIFT_THRESHOLD=0.8
WINDOW_SIZE=5
